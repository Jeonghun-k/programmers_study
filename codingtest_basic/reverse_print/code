class Solution {
    public int[] solution(int[] num_list) {
        // 반복문 : num_list안에 있는것을 뒤에부터 reverse 안에 저장
        // 그리고 reverse를 출력        
        int n = num_list.length;         // 리스트의 길이를 n변수에 입력
        int[] reverse = new int[n];      // 거꾸로 뒤집은 배열 생성
        
        for(int i = 0; i < n; i++){
            reverse[i] = num_list[n-1-i];
        }
        
        return reverse;
    }
}
